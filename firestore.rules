rules_version = '2';

// Paste into Firebase Console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isUser(uid);
    }

    // TODO: Restrict writes to admins once statues and races are seeded.
    match /statues/{statueId} {
      allow read, write: if signedIn();
    }

    match /races/{raceId} {
      allow read, write: if signedIn();
    }

    match /raceAttempts/{attemptId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.userId);
      allow update, delete: if isUser(resource.data.userId);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.requesterId);
      allow update, delete: if isUser(resource.data.requesterId) || isUser(resource.data.receiverId);
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.challengerId);
      allow update, delete: if isUser(resource.data.challengerId) || isUser(resource.data.challengedId);
    }
  }
}
